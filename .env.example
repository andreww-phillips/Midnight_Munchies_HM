# Optional settings for docker compose. Copy to .env to use them.

# Backend catalog source: memory (default) or supabase.
CATALOG_MODE=memory
# Only needed when CATALOG_MODE=supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Frontend, baked in at build time. The API URL must be reachable from the browser.
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
